{
  // ============================================================
  // Konfigurace nasazení na Cloudflare (Workers + statické soubory)
  // ============================================================
  "name": "stredoskolska-lupa",
  "compatibility_date": "2026-08-31",

  // Skript, který hlídá přístup do administrace
  "main": "worker.js",

  "assets": {
    // celý web je v kořeni repozitáře
    "directory": "./",
    "binding": "ASSETS",
    // neexistující adresa -> naše vlastní 404 stránka
    "not_found_handling": "404-page",
    // skript musí běžet dřív než servírování souborů, aby stihl
    // zkontrolovat heslo u administrace
    "run_worker_first": true
  },

  // Úložiště přihlašovacích údajů do administrace.
  // Účty se sem zapisují ze záložky „Účty" — v repozitáři nejsou.
  "kv_namespaces": [
    {
      "binding": "ADMIN_KV",
      "id": "caf8880eabb3408f9e0012bce239defb"
    }
  ],

  "observability": {
    "enabled": true
  }
}
